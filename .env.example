# Copy this file to .env and fill in from Supabase → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# DEMO MODE while .env is populated: `npm run dev:demo` (port 5175). It loads
# .env.demo, which blanks the two values above, so the app falls back to the
# localStorage demo adapter without anyone having to move .env out of the way.
# Create .env.demo with both VITE_SUPABASE_* keys set to empty. Added 2026-07-28.

# Outlook calendar push (Phase 1) — see docs/outlook-setup.md
# Application (client) ID of the Entra app registration:
VITE_MSAL_CLIENT_ID=
# Directory (tenant) ID — leave blank to use 'common':
VITE_MSAL_TENANT_ID=
# Dedicated Outlook calendar name (created if missing); default "MDBP Cases":
VITE_OUTLOOK_CALENDAR_NAME=
